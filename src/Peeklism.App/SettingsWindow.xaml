<Window
    x:Class="Peeklism.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Peeklism 設定">
    <ScrollViewer Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <StackPanel x:Name="Root" Padding="32" Spacing="20" MaxWidth="640" HorizontalAlignment="Stretch">
            <TextBlock Text="設定" Style="{ThemeResource TitleTextBlockStyle}" />
            <TextBlock Text="預覽" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <ToggleSwitch x:Name="TopmostSwitch" Header="預覽視窗保持在最上層"
                          Toggled="OnTopmostChanged" />
            <ToggleSwitch x:Name="PreloadSwitch" Header="加快第一次預覽"
                          Toggled="OnPreloadChanged" />
            <TextBlock Text="開啟後會增加背景記憶體用量。變更會在下次啟動時生效。"
                       TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="啟動" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="0,8,0,0" />
            <ToggleSwitch x:Name="LoginSwitch" Header="登入 Windows 時啟動"
                          Toggled="OnLoginChanged" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
    </ScrollViewer>
</Window>
