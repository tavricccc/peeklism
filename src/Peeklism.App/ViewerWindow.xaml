<Window
    x:Class="Peeklism.App.ViewerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Peeklism">
    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
          AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" KeyDown="OnKeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <CommandBar x:Name="Toolbar" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
            <AppBarButton Label="開啟" Icon="OpenFile" Click="OnOpen" ToolTipService.ToolTip="開啟檔案 (Ctrl+O)" />
            <AppBarButton x:Name="PreviousButton" Label="上一個" Icon="Previous" Click="OnPrevious" />
            <AppBarButton x:Name="NextButton" Label="下一個" Icon="Next" Click="OnNext" />
            <AppBarSeparator />
            <AppBarButton x:Name="FitButton" Label="符合視窗" Click="OnFit">
                <AppBarButton.Icon><FontIcon Glyph="&#xE9A6;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ActualButton" Label="原始大小" Click="OnActual" ToolTipService.ToolTip="100% 原始像素 (Ctrl+1)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE9A6;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="ZoomOutButton" Label="縮小" Icon="ZoomOut" Click="OnZoomOut" />
            <AppBarButton x:Name="ZoomInButton" Label="放大" Icon="ZoomIn" Click="OnZoomIn" />
            <AppBarButton x:Name="RotateButton" Label="旋轉" Icon="Rotate" Click="OnRotate" />
            <AppBarToggleButton x:Name="SourceButton" Label="原始碼" Icon="Edit" Click="OnSource" />
            <AppBarButton Label="全螢幕" Icon="FullScreen" Click="OnFullScreen" ToolTipService.ToolTip="全螢幕 (F11)，Esc 返回" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="在檔案總管顯示" Icon="Folder" Click="OnReveal" />
                <AppBarButton Label="複製路徑" Icon="Copy" Click="OnCopyPath" />
                <AppBarButton Label="重新載入" Icon="Refresh" Click="OnReload" />
                <AppBarButton Label="快捷鍵與說明" Icon="Help" Click="OnHelp" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <Grid Grid.Row="1">
            <ContentControl x:Name="Host" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="480" Margin="32">
                <FontIcon Glyph="&#xE8E5;" FontSize="40" />
                <TextBlock Text="開啟檔案，完整查看" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="將圖片、影片、PDF 或 Markdown 拖曳到這裡，或按 Ctrl+O 選擇檔案。" TextWrapping="Wrap" TextAlignment="Center" />
                <Button Content="選擇檔案" Click="OnOpen" HorizontalAlignment="Center" />
                <TextBlock Text="檔案總管中的空白鍵仍是快速預覽。" FontSize="12" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel x:Name="LoadingState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                <ProgressRing x:Name="LoadingRing" IsActive="False" Width="32" Height="32" />
                <TextBlock Text="正在開啟檔案…" />
            </StackPanel>
            <StackPanel x:Name="ErrorState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Margin="32" Spacing="16">
                <TextBlock Text="無法開啟這個檔案" FontSize="22" FontWeight="SemiBold" />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Button Content="重試" Click="OnReload" />
                    <Button Content="開啟其他檔案" Click="OnOpen" />
                </StackPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2" Padding="16,8" ColumnSpacing="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock x:Name="FileLabel" Text="Peeklism · 唯讀查看器" FontSize="12" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="StatusLabel" Grid.Column="1" FontSize="12" Text="Ctrl+O 開啟檔案" />
        </Grid>
    </Grid>
</Window>
